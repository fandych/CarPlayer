import { projectionTheme } from '../video/ProjectionSettings';
import { ProjectionDashboardState } from './ProjectionDashboardState';
import { ProjectionDashboardAppController } from './ProjectionDashboardAppController';
import { ProjectionDashboardPresentationController } from './ProjectionDashboardPresentationController';
import { ProjectionDashboardShell } from './ProjectionDashboardShell';
import { ProjectionDashboardShellBindings } from './ProjectionDashboardShellBindingsTypes';

export interface ProjectionDashboardRenderOptions {
  state: ProjectionDashboardState;
  app: ProjectionDashboardAppController;
  presentation: ProjectionDashboardPresentationController;
  bindings: ProjectionDashboardShellBindings;
}

@Builder
export function renderProjectionDashboard(options: ProjectionDashboardRenderOptions) {
  ProjectionDashboardShell({
    theme: options.state.theme,
    accent: options.state.accent,
    dayNightMode: options.state.dayNightMode,
    nightMode: options.state.nightMode,
    dockPosition: options.state.dockPosition,
    dashboardView: options.state.dashboardView,
    preserveSplitSurfaceForOverlays: options.state.preserveSplitSurfaceForOverlays,
    settingsTab: options.state.settingsTab,
    activeSettingsDropdown: options.state.activeSettingsDropdown,
    displayBrightness: options.state.displayBrightness,
    splitMapRatio: options.state.splitMapRatio,
    splitMusicRatio: options.state.splitMusicRatio,
    splitMapRatioInput: options.state.splitMapRatioInput,
    splitMusicRatioInput: options.state.splitMusicRatioInput,
    splitRatioMessage: options.state.splitRatioMessage,
    selectedMapUri: options.state.selectedMapUri,
    selectedMusicUri: options.state.selectedMusicUri,
    apps: options.state.apps,
    appsGridColumns: options.state.appsGridColumns,
    appsGridTemplate: options.app.appsGridTemplate(options.state),
    activeAppLabel: options.state.activeAppLabel,
    activeAppUri: options.state.activeAppUri,
    appOnPhone: options.state.appOnPhone,
    mapAppLabel: options.state.mapAppLabel,
    mapAppUri: options.state.mapAppUri,
    mapOnPhone: options.state.mapOnPhone,
    navigationPreview: options.state.navigationPreview,
    launchMessage: options.state.launchMessage,
    mapMessage: options.state.mapMessage,
    mediaState: options.state.mediaState,
    dockActionMessage: options.state.dockActionMessage,
    dockHint: options.state.dockHint,
    batteryPercent: options.state.batteryPercent,
    signalLevel: options.state.signalLevel,
    networkLabel: options.state.networkLabel,
    dockIconSize: options.state.dockIconSize,
    deviceDisplayUuid: options.state.vehicleDisplayUuid,
    safeInsetTop: options.state.safeInsetTop,
    safeInsetRight: options.state.safeInsetRight,
    safeInsetBottom: options.state.safeInsetBottom,
    safeInsetLeft: options.state.safeInsetLeft,
    contentScalePercent: options.state.contentScalePercent,
    contentOffsetXPercent: options.state.contentOffsetXPercent,
    contentOffsetYPercent: options.state.contentOffsetYPercent,
    calibrationMessage: options.state.calibrationMessage,
    projectionModeOptions: options.state.projectionModeOptions,
    selectedProjectionModeId: options.state.selectedProjectionModeId,
    activeProjectionModeId: options.state.activeProjectionModeId,
    projectionResolutionMessage: options.state.projectionResolutionMessage,
    resolutionSelectionMessage: options.state.resolutionSelectionMessage,
    projectionNativeWidth: options.state.projectionNativeWidth,
    projectionNativeHeight: options.state.projectionNativeHeight,
    useBluetoothAudio: options.state.useBluetoothAudio,
    encoderFps: options.state.encoderFps,
    captureFps: options.state.captureFps,
    activeEncoderFps: options.state.activeEncoderFps,
    activeCaptureFps: options.state.activeCaptureFps,
    receiverHomeMessage: options.state.receiverHomeMessage,
    viewAreaOriginX: options.state.viewAreaOriginX,
    viewAreaOriginY: options.state.viewAreaOriginY,
    primaryTextColor: options.presentation.primaryTextColor(options.state),
    secondaryTextColor: options.presentation.secondaryTextColor(options.state),
    mutedTextColor: options.presentation.mutedTextColor(options.state),
    mapBackgroundColor: options.presentation.mapBackgroundColor(options.state),
    glassStrokeColor: options.presentation.glassStrokeColor(options.state),
    cardStrokeColor: options.presentation.cardStrokeColor(options.state),
    glassSecondaryColor: options.presentation.glassSecondaryColor(options.state),
    glassPanelColor: options.presentation.glassPanelColor(options.state),
    glassSurfaceColor: options.presentation.glassSurfaceColor(options.state),
    settingsPanelColor: options.presentation.settingsPanelColor(options.state),
    settingsGroupColor: options.presentation.settingsGroupColor(options.state),
    settingsSeparatorColor: options.presentation.settingsSeparatorColor(options.state),
    lightAppearance: options.presentation.isLightAppearance(options.state),
    themeBackgroundColor: projectionTheme(options.state.theme).background,
    dockItems: options.app.dockItems(options.state),
    verticalDock: options.state.dockPosition !== 'bottom',
    wallpaperResource: options.bindings.wallpaperResource,
    mapPreviewResource: options.bindings.mapPreviewResource,
    dockIconResource: options.bindings.dockIconResource,
    settingsIconResource: options.bindings.settingsIconResource,
    onSettingsTabChange: options.bindings.onSettingsTabChange,
    onDockAction: options.bindings.onDockAction,
    onDockHintChange: options.bindings.onDockHintChange,
    onThemeChange: options.bindings.onThemeChange,
    onAccentChange: options.bindings.onAccentChange,
    onDockMenuBoundsChange: options.bindings.onDockMenuBoundsChange,
    onSelectApp: options.bindings.onSelectApp,
    onAppSurfaceChange: options.bindings.onAppSurfaceChange,
    onMapSurfaceChange: options.bindings.onMapSurfaceChange,
    onTouchAreaChange: options.bindings.onTouchAreaChange,
    onTouchBoundsChange: options.bindings.onTouchBoundsChange,
    onToggleAppDisplay: options.bindings.onToggleAppDisplay,
    onToggleMapDisplay: options.bindings.onToggleMapDisplay,
    onHomeClick: options.bindings.onHomeClick,
    onOpenMediaApp: options.bindings.onOpenMediaApp,
    onOpenMapApp: options.bindings.onOpenMapApp,
    onSendMediaCommand: options.bindings.onSendMediaCommand,
    onDayNightModeChange: options.bindings.onDayNightModeChange,
    onBrightnessChange: options.bindings.onBrightnessChange,
    onBrightnessTouch: options.bindings.onBrightnessTouch,
    onSplitRatioAdjust: options.bindings.onSplitRatioAdjust,
    onSplitRatioInputChange: options.bindings.onSplitRatioInputChange,
    onSplitRatioRestore: options.bindings.onSplitRatioRestore,
    onSplitRatioFocus: options.bindings.onSplitRatioFocus,
    onDockPositionToggle: options.bindings.onDockPositionToggle,
    onSafeInsetAdjust: options.bindings.onSafeInsetAdjust,
    onContentCalibrationAdjust: options.bindings.onContentCalibrationAdjust,
    onDropdownToggle: options.bindings.onDropdownToggle,
    onDropdownSelect: options.bindings.onDropdownSelect,
    onProjectionContentAreaChange: options.bindings.onProjectionContentAreaChange,
    onDockScrollerReady: options.bindings.onDockScrollerReady,
    onAppsScrollerReady: options.bindings.onAppsScrollerReady,
    onDockMenuScrollerReady: options.bindings.onDockMenuScrollerReady,
    onSettingsScrollerReady: options.bindings.onSettingsScrollerReady,
    onThemesScrollerReady: options.bindings.onThemesScrollerReady,
    onGridAreaChange: options.bindings.onGridAreaChange,
    onViewportAreaChange: options.bindings.onViewportAreaChange,
    onEncoderFpsSelect: options.bindings.onEncoderFpsSelect,
    onCaptureFpsSelect: options.bindings.onCaptureFpsSelect,
    onBluetoothAudioChange: options.bindings.onBluetoothAudioChange,
  })
}
