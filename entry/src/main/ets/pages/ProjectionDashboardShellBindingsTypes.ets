import { ProjectionApp } from './ProjectionAppCatalog';
import { ProjectionMediaCommand } from '../session/MediaSessionBridge';
import { ProjectionCalibrationControl, ProjectionSafeInsetEdge, ProjectionSplitPane } from '../video/ProjectionSettings';

export interface ProjectionDashboardShellBindings {
  wallpaperResource: (themeId: string) => Resource;
  mapPreviewResource: () => Resource;
  dockIconResource: (icon: string, selected: boolean) => Resource;
  settingsIconResource: (lightIcon: string, darkIcon: string, selected?: boolean) => Resource;
  onSettingsTabChange: (tab: string) => void;
  onDockAction: (id: string, longPress: boolean) => void;
  onDockHintChange: (hint: string) => void;
  onThemeChange: (themeId: string) => void;
  onAccentChange: (color: string) => void;
  onDockMenuBoundsChange: (area: Area) => void;
  onSelectApp: (app: ProjectionApp) => void;
  onAppSurfaceChange: (surfaceId: string, area: Area | undefined, attached: boolean) => void;
  onMapSurfaceChange: (surfaceId: string, area: Area | undefined, attached: boolean) => void;
  onTouchAreaChange: (group: string, key: string, area: Area, action: () => void, longPress?: () => void, drag?: (pointX: number) => void) => void;
  onTouchBoundsChange: (group: string, area: Area) => void;
  onToggleAppDisplay: () => void;
  onToggleMapDisplay: () => void;
  onHomeClick: () => void;
  onOpenMediaApp: () => void;
  onOpenMapApp: () => void;
  onSendMediaCommand: (command: ProjectionMediaCommand) => void;
  onDayNightModeChange: (mode: 'AUTO' | 'DAY' | 'NIGHT') => void;
  onBrightnessChange: (value: number) => void;
  onBrightnessTouch: (pointX: number, area: Area) => void;
  onSplitRatioAdjust: (pane: ProjectionSplitPane, delta: number) => void;
  onSplitRatioInputChange: (pane: ProjectionSplitPane, value: string) => void;
  onSplitRatioRestore: (pane: ProjectionSplitPane) => void;
  onSplitRatioFocus: (pane: ProjectionSplitPane) => void;
  onDockPositionToggle: () => void;
  onSafeInsetAdjust: (edge: ProjectionSafeInsetEdge, delta: number) => void;
  onContentCalibrationAdjust: (control: ProjectionCalibrationControl, delta: number) => void;
  onDropdownToggle: (key: string) => void;
  onDropdownSelect: (key: string, index: number) => void;
  onProjectionContentAreaChange: (area: Area) => void;
  onDockScrollerReady: (scroller: Scroller) => void;
  onAppsScrollerReady: (scroller: Scroller) => void;
  onDockMenuScrollerReady: (scroller: Scroller) => void;
  onSettingsScrollerReady: (scroller: Scroller) => void;
  onThemesScrollerReady: (scroller: Scroller) => void;
  onGridAreaChange: (area: Area) => void;
  onViewportAreaChange: (area: Area) => void;
  onEncoderFpsSelect: (index: number) => void;
  onCaptureFpsSelect: (index: number) => void;
  onBluetoothAudioChange: (enabled: boolean) => void;
}
